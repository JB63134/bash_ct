#!/usr/bin/env bash
#-----------------------------------------------------------------------------------------------
# Command Trace aka ct                                                                    
# Purpose: Analyzes a Bash command, alias, builtin, keyword,  function, or binary
#          Trace command resolution, with shadowed command detection.        
#-----------------------------------------------------------------------------------------------
# Copyright (c) 2025-2026 John Blair
# Licensed under the MIT License. See LICENSE file for details.        
#-----------------------------------------------------------------------------------------------
# BEHAVIORAL NOTES:
#
# • This script is intended to be SOURCED into an interactive Bash shell.
# • This script does NOT use `set -euo pipefail`.
# • PATH may be extended during execution to improve discovery of administrative directories. 
#   PATH is restored on exit.
#
# • Shell option `extglob` may be enabled temporarily and is restored afterward.
#
# • Kernel-level inspection may occur for PATH executables, including:
#     - symlink resolution
#     - ELF interpreter detection
#     - shebang parsing
#     - alternatives system detection
#
# • Bare command names only. 
#   Paths (e.g. /bin/ls) are rejected.
#-----------------------------------------------------------------------------------------------
# AUTO-EXTENDED DISCOVERY (JSON: auto_extended)
#
# When ct is invoked without -x/--extend and a command is not
# found in the user's PATH, ct will temporarily include known
# administrative paths (e.g. /usr/sbin, /sbin) to locate the command.
#
# This behavior:
#   • does NOT modify PATH permanently
#   • does NOT execute the command
#   • is intended for interactive discovery
#
# When auto-extension occurs, JSON output includes:
#
#   "auto_extended": true
#
# MANUAL EXTENSION (-x/--extend)
#
# • Adding -x/--extend disables automatic-extension semantics and forces ct
#   to temporarily extend its executable search path, even when the command
#   has already been found earlier in the resolution chain.
#
#   Without -x:
#     • If resolution fails → ct temporarily extends $PATH to include system
#       directories and tries again.
#
#   With -x:
#     • Even if resolution succeeds → ct still extends the search path.
#     • This allows shadowed commands in administrative directories to be
#       detected.
#-----------------------------------------------------------------------------------------------
if [[ -z "${BASH_VERSION:-}" ]]; then
    printf "ct must be sourced or executed by bash.\n" >&2
    return 1
fi

__CT_version=4.4.50
__CT_needed_deps=(readlink readelf mktemp stat)
__CT_optional_deps=(tput)
__CT_extglob_was=0
__CT_PATH_SAVED=0
__CT_POSIX_SPECIAL_BUILTINS=(
    :
    .
    break
    continue
    eval
    exec
    exit
    export
    readonly
    return
    set
    shift
    times
    trap
    unset
)

mapfile -t __CT_KEYWORDS < <(compgen -k)
mapfile -t __CT_BUILTINS < <(compgen -b)

complete -F _ct_completion ct

#------------------------------------------------------------------------
# Function: ct
# Purpose : User-facing entry point.
#------------------------------------------------------------------------
ct() {
    local rc

    _ct_main "$@"
    rc=$?

    _ct_exit

    return "$rc"
}

#------------------------------------------------------------------------
# Function: _ct_main
#
# Behavior:
# • Parses command-line options
# • Rejects path-based input
# • Dispatches to human-readable or JSON output
#
# Exit codes:
# • 0  → successful resolution
# • 1  → command not found or invalid input
#------------------------------------------------------------------------
_ct_main() {
    local __CT_JSON_OUTPUT=0
    local __CT_EXTEND_PATH=0
    local __CT_AUTO_EXTEND=0
    local __CT_CONFLICT=0

    while [[ $# -gt 0 ]]; do
        local arg="$1"

        case "$arg" in
            --help)
                _ct_usage
                return 0
                ;;
            --version)
                _ct_ver
                return 0
                ;;
            --conflict) 
                __CT_CONFLICT=1
                shift
                ;; 
            --json)
                __CT_JSON_OUTPUT=1
                shift
                ;;
            --extend)
                __CT_EXTEND_PATH=1
                shift
                ;;
            -*)  # short flags, possibly combined like -jx
                local i
                for (( i=1; i<${#arg}; i++ )); do
                    local flag="${arg:i:1}"
                    case "$flag" in
                        j) __CT_JSON_OUTPUT=1 ;;
                        x) __CT_EXTEND_PATH=1 ;;
                        c) __CT_CONFLICT=1 ;;
                        h)
                            _ct_usage
                            return 0
                            ;;
                        v)
                            _ct_ver
                            return 0
                            ;;
                        *)
                            printf "Unknown option: -%s\n" "$flag" >&2
                            return 1
                            ;;
                    esac
                done
                shift
                ;;
            *)
                break  # first non-option argument (command)
                ;;
        esac
    done
    
    if [[ $__CT_CONFLICT == 1 ]]; then
       _ct_conflicts "$__CT_JSON_OUTPUT" "$__CT_EXTEND_PATH"
       return 0
    fi
    
    # Validate input
    [[ -z "$1" ]] && _ct_usage && return 0
    
    # Auto-extend PATH if command not found but exists in admin paths
    if [[ -n "$1" && $__CT_EXTEND_PATH -eq 0 ]]; then
        if ! command -v -- "$1" &>/dev/null; then
            if _ct_found_in_admin_paths "$1"; then
                __CT_EXTEND_PATH=1
                __CT_AUTO_EXTEND=1
            fi
        fi
    fi

    # ---- Startup ----  
    _ct_startup "$__CT_EXTEND_PATH" || return 1
    
    # JSON mode rejects path input
    if [[ $__CT_JSON_OUTPUT == 1 && "$1" == */* ]]; then
        local message_json

        if [[ -d "$1" ]]; then
            message_json=$(_ct_json_string_or_null \
            "$1 is a directory. Command Trace only works with bare command names.")
        elif [[ -f "$1" ]]; then
            message_json=$(_ct_json_string_or_null \
            "$1 is a file. Command Trace only works with bare command names.")
        else
            message_json=$(_ct_json_string_or_null \
            "$1 is a pathname. Command Trace only works with bare command names.")
        fi

        printf '{ "error": true, "type": "invalid_input", "message": %s }\n' \
            "$message_json"
        return 1
    fi
    
    # Human-readable mode rejects path input with explanation
    if [[ "$1" == */* ]]; then
        if [[ -d "$1" ]]; then
            printf "├─ ${__CT_RED}%s is a directory${__CT_RESET}\n" "$1"
        elif [[ -f "$1" ]]; then
            printf "├─ ${__CT_RED}%s is a file${__CT_RESET}\n" "$1"
        else
            printf "├─ ${__CT_RED}%s is a pathname${__CT_RESET}\n" "$1"
        fi

        printf "    ↳ Command Trace only works with bare command names.\n\n"
        return 1
    fi
    
    # Dispatch output
    if (( __CT_JSON_OUTPUT )); then
        _ct_json_output "$1" 
    else
        _ct_print_trace "$1"
    fi
}

#------------------------------------------------------------------------
# Function: _ct_resolve
# Purpose : Core command resolution engine.
#
# Inputs:
#   $1 → command name (bare token, no path)
#   $2 → nameref to associative array for resolution results (RES)
#   $3 → nameref to indexed array for PATH scan results (PATH_ENTRIES)
#
# Outputs (RES associative array):
#   command          → original command string
#   bash_type        → alias|function|keyword|builtin|path|notfound
#   shadowed_fs      → true if filesystem executables are unreachable
#
#   alias_*          → alias detection and definition
#   function_*       → function location and line
#   builtin_*        → builtin state (enabled/disabled)
#   keyword_found    → keyword match
#
#   kernel_*         → execution target details (PATH only)
#
# Notes:
# • Resolution precedence follows Bash rules, not filesystem order.
# • PATH scanning records *all* candidates, not just the winner.
#------------------------------------------------------------------------
# shellcheck disable=SC2154
_ct_resolve() {
    local cmd="$1"
    local -n R="$2"      # associative result
    local -n P="$3"      # indexed PATH entries
    local alias_out
    
    # shellcheck disable=SC2034  
    R=()
    P=()

    R[command]="$cmd"
    R[bash_type]="notfound"
    R[shadowed_fs]=false
    R[function_shadowed]=false
    R[builtin_shadowed]=false
    R[keyword_shadowed_alias]=false
    R[alias_shadowed]=false
    R[posix_mode]=false
    R[empty_path_component]=false
    
    # ------------------------------------------------------------
    # Alias
    # ------------------------------------------------------------
    if alias "$cmd" &>/dev/null; then

        alias_out=$(alias -- "$cmd" 2>/dev/null) || return

        R[alias_found]=true
        R[alias_def]="$alias_out"
        R[bash_type]="alias"
    else
        R[alias_found]=false
    fi

    # ------------------------------------------------------------
    # POSIX mode / special builtin precedence
    # ------------------------------------------------------------
    if (( __CT_POSIX_MODE )); then
        R[posix_mode]=true
    fi
  
    # ------------------------------------------------------------
    # Function
    #
    # In POSIX mode, POSIX special builtins have precedence over
    # functions. Bash will not use the function as the command
    # resolution target.
    # ------------------------------------------------------------
    if declare -F "$cmd" &>/dev/null; then

        R[function_found]=true

        local line file
        shopt -q extdebug || { shopt -s extdebug; local _ext=1; }
        read -r _ line file <<<"$(declare -F "$cmd")"
        [[ $_ext ]] && shopt -u extdebug

        R[function_file]="${file:-interactive shell}"
        R[function_line]="$line"

        # POSIX special builtin wins over function
        if (( __CT_POSIX_MODE )) && _ct_is_posix_special_builtin "$cmd"; then
            R[function_shadowed]=true

        # Normal Bash precedence:
        # alias > function > builtin > PATH
        elif [[ ${R[bash_type]} =~ ^(alias|keyword|builtin)$ ]]; then
            R[function_shadowed]=true

        else
            R[bash_type]="function"
            R[function_shadowed]=false
        fi

    else
        R[function_found]=false
    fi

    # ------------------------------------------------------------
    # Keyword (higher precedence than builtin)
    # ------------------------------------------------------------
    if _ct_cache_compgen "$cmd" __CT_KEYWORDS; then
        R[keyword_found]=true
        R[bash_type]="keyword" 
    else
        R[keyword_found]=false
    fi

    if [[ ${R[keyword_found]} == true && ${R[alias_found]} == true ]]; then
        R[keyword_shadowed_alias]=true
    fi
    
    # ------------------------------------------------------------
    # Builtin
    # ------------------------------------------------------------
    if _ct_cache_compgen "$cmd" __CT_BUILTINS; then
        R[builtin_found]=true

        # enabled/disabled state
        R[builtin_state]="enabled"
        while read -r _ _ disabledbuiltin; do
            if [[ $disabledbuiltin == "$cmd" ]]; then
                R[builtin_state]="disabled"
                break
            fi
        done < <(enable -n)

        # shadowed only if enabled and something higher-precedence exists
        if [[ ${R[builtin_state]} == "enabled" &&
              ${R[bash_type]} =~ ^(alias|function|keyword)$ &&
              ( "$__CT_POSIX_MODE" -eq 0 || ! $(_ct_is_posix_special_builtin "$cmd") ) ]]; then
            R[builtin_shadowed]=true
        fi

        # builtin wins only if enabled and not shadowed,
        # and nothing higher-precedence resolved
        if [[ ${R[builtin_state]} == "enabled" &&
              ${R[builtin_shadowed]} == false &&
              ${R[bash_type]} == "notfound" ]]; then
            R[bash_type]="builtin"
            R[bash_winner]="$cmd"
        fi

    else
        R[builtin_found]=false
        R[builtin_state]=null
    fi

    # ------------------------------------------------------------
    # PATH scan
    # PATH entry encoding format (PATH_ENTRIES):
    #   "dir|state|target|shadow"
    #
    #   dir     → PATH directory
    #   state   → notfound | file | symlink
    #   target  → resolved target (for symlink), empty otherwise
    #   shadow  → true if this entry is unreachable by bare invocation
    # ------------------------------------------------------------
    local found_path=""
    local path_winner_seen=0

    IFS=: read -ra _dirs <<<"$PATH"
    # Preserve a trailing empty PATH component.
    if [[ -z "$PATH" ]]; then
        _dirs=("")
    elif [[ "$PATH" == *: ]]; then
        _dirs+=("")
    fi
    
    for d in "${_dirs[@]}"; do
        # An empty PATH component means bash uses the current directory.
        if [[ -z $d ]]; then
            R[empty_path_component]=true
        fi
    
        local lookup_dir="${d:-.}"
        local p="$lookup_dir/$cmd"
        
        # Skip if not executable
        if [[ ! -f "$p" || ! -x "$p" ]]; then
            P+=("$d|notfound||false")
            continue
        fi

        local state=file target="$p"
        if [[ -L "$p" ]]; then
            state=symlink
            target="$(readlink "$p")"
        fi

        local shadow=false
        # Mark as shadowed if a higher-priority Bash resolution exists
        if [[ ${R[bash_type]} =~ ^(alias|function|builtin|keyword)$ ]]; then
            shadow=true
            R[shadowed_fs]=true
        elif (( path_winner_seen )); then
            shadow=true
        else
            path_winner_seen=1
            # Only set bash_type=path if no higher-priority type is set
            [[ ${R[bash_type]} == "notfound" ]] && R[bash_type]="path"
            found_path="$p"
        fi

        P+=("$d|$state|$target|$shadow")
    done

    # ------------------------------------------------------------
    # Kernel execution details + alternatives detection
    # ------------------------------------------------------------
    if [[ ${R[bash_type]} == "path" && -n $found_path ]]; then
        R[kernel_path]="$found_path"
        R[kernel_canonical]="$(readlink -f "$found_path")"
        R[elf_interp]=""
        R[shebang]=""

        # ELF interpreter (if ELF binary)
        R[elf_interp]=""

        while IFS= read -r line; do
            case $line in
                *"Requesting program interpreter:"*)
                    line=${line#*: }
                    line=${line#[}
                    line=${line%]}
                    R[elf_interp]=$line
                    break
                    ;;
            esac
        done < <(readelf -l "${R[kernel_canonical]}" 2>/dev/null)

        # Shebang (if script)
        if IFS= read -r line < "${R[kernel_canonical]}" 2>/dev/null &&
            [[ $line == '#!'* ]]; then
            R[shebang]=$line
        fi

        # Symlink chain (safe string for JSON)
        local chain=()
        local x="$found_path"

        while [[ -L "$x" ]]; do
            y="$(readlink "$x")"
            chain+=("$x -> $y")

            if [[ $y == /* ]]; then
                x="$y"
            else
                x="${x%/*}/$y"
            fi
        done
        
        R[kernel_chain]=$(printf '%s\n' "${chain[@]}")  # newline-delimited string

        # Alternatives detection
        R[alternatives]=false
        R[alternatives_link]=null
        R[alternatives_target]=null

        x="$found_path"
        while [[ -L "$x" ]]; do
            if [[ "$x" == /etc/alternatives/* ]]; then
                R[alternatives]=true
                R[alternatives_link]="$x"
                R[alternatives_target]="$(readlink -f "$x")"
                break
            fi
            x="$(readlink -f "$x")"
        done
    fi
    
    : "${R[bash_type]:=notfound}"
    return 0
}

#------------------------------------------------------------------------
# Function: _ct_cache_compgen "$cmd" __CT_KEYWORDS
# Purpose: avoid abusing compgen for a report mode (multiple commands at once)
#------------------------------------------------------------------------
_ct_cache_compgen() {
    local needle="$1"
    local -n haystack="$2"
    local item

    for item in "${haystack[@]}"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

#------------------------------------------------------------------------
# Function: _ct_is_posix_special_builtin
# Purpose: check if command is a posix special builtin
#------------------------------------------------------------------------
_ct_is_posix_special_builtin() {
    local b
    for b in "${__CT_POSIX_SPECIAL_BUILTINS[@]}"; do
        [[ $b == "$1" ]] && return 0
    done
    return 1
}

#------------------------------------------------------------------------
# Function: _ct_found_in_admin_paths
# Purpose: check if command exists outside of user path
#------------------------------------------------------------------------
_ct_found_in_admin_paths() {
    local cmd="$1"
    local d
    
    local _CT_ADMIN_PATHS=(
    "/flatpak/bin"
    "/snap/bin"
    "/usr/local/sbin"
    "/usr/sbin"
    "/sbin"
    "/opt/sbin"
    )
    
    for d in "${_CT_ADMIN_PATHS[@]}"; do
        [[ -x "$d/$cmd" && -f "$d/$cmd" ]] && return 0
    done
    return 1
}

#------------------------------------------------------------------------
# Function: _ct_print_trace
# Purpose: Command Resolution Trace human display
#------------------------------------------------------------------------
# Human Output:
#
# • "Bash Resolution Target"
#     What Bash resolves the command to, based on shell semantics.
#
# • "Kernel Execution Target"
#     What the kernel actually executes (filesystem path, interpreter).
#
# These are intentionally separated to highlight shadowing and indirection.
#------------------------------------------------------------------------
_ct_print_trace() {
    local cmd="$1"

    declare -A RES
    declare -a PATH_ENTRIES

    _ct_resolve "$cmd" RES PATH_ENTRIES || return 1
    
    if [[ ${RES[bash_type]} == "notfound" ]]; then
          printf "${__CT_RED}Unknown or invalid command: ${__CT_CYAN}%s${__CT_RESET}\n" "$cmd"
          printf "  ↳ Check your spelling and try again\n\n"
         return 1
     fi

    printf "Command Trace of ${__CT_CYAN}%s${__CT_RESET}\n" "$cmd"

    if (( __CT_AUTO_EXTEND )); then 
        printf "\n"
        printf "Not in \$USER \$PATH\n  ↳ Found in system \$PATH %s(auto-extended)%s:\n" "${__CT_YELLOW}" "${__CT_RESET}"
    fi
        # Dispatch output
    if (( __CT_POSIX_MODE )); then
        printf "\n"
        printf "Bash is in POSIX mode:\n  ↳ POSIX special builtins take precedence over functions
with the same name.\n"
    fi
    printf "\n"

    # ------------------------------------------------------------
    # Keyword
    # ------------------------------------------------------------
    if [[ ${RES[keyword_found]} == true ]]; then
        printf "Keyword:  -  ${__CT_CYAN}%s → found${__CT_RESET}\n" "$cmd"
    else
        printf "Keyword:  -  not found\n"
    fi

    # ------------------------------------------------------------
    # Alias
    # ------------------------------------------------------------
    if [[ ${RES[alias_found]} == true ]]; then 
            printf "Alias:    -  ${__CT_CYAN}%s → found → %s${__CT_RESET}\n" "$cmd" "${RES[alias_def]}"   
    else
        printf "Alias:    -  not found\n"
    fi
    
    # ------------------------------------------------------------
    # Function
    # ------------------------------------------------------------
    if [[ ${RES[function_found]} == true ]]; then
        if [[ ${RES[function_shadowed]} == true ]]; then
            printf "Function: -  ${__CT_GREY}%s → found → Function %s (%s : line %s) [shadowed]${__CT_RESET}\n" \
            "$cmd" "$cmd" "${RES[function_file]}" "${RES[function_line]}"
        else
            printf "Function: -  ${__CT_CYAN}%s → found → Function %s (%s : line %s)${__CT_RESET}\n" \
            "$cmd" "$cmd" "${RES[function_file]}" "${RES[function_line]}"
        fi
    else
        printf "Function: -  not found\n"
    fi

    # ------------------------------------------------------------
    # Builtin
    # ------------------------------------------------------------
    if [[ ${RES[builtin_found]} == true ]]; then
        if [[ ${RES[builtin_state]} == "enabled" ]]; then
            if [[ ${RES[builtin_shadowed]} == true ]]; then
                printf "Builtin:  -  ${__CT_GREY}%s → found → %s [shadowed]${__CT_RESET}\n" \
                       "$cmd" "${RES[builtin_state]}"      
            else
                printf "Builtin:  -  ${__CT_CYAN}%s → found → %s${__CT_RESET}\n" \
                   "$cmd" "${RES[builtin_state]}"
            fi           
        else
            printf "Builtin:  -  ${__CT_GREY}%s → found → %s${__CT_RESET}\n" \
            "$cmd" "${RES[builtin_state]}"       
        fi                   
    else
        printf "Builtin:  -  not found\n"
    fi
    printf "\n"   
    
    # ------------------------------------------------------------
    # PATH scan rendering
    #
    # Shows every PATH entry in order, not just the winner.
    # Shadowed entries indicate commands that exist but cannot
    # be reached via bare invocation.
    # ------------------------------------------------------------
    printf "\$PATH in order:\n"

    for entry in "${PATH_ENTRIES[@]}"; do
        IFS='|' read -r dir state target shadow <<<"$entry"
       
        local usr_merged=""
        local lookup_dir="${dir:-.}"
        local display_dir="$dir"
        
        if [[ -z $dir ]]; then
            display_dir="'' (current directory)"
        fi

        # Detect usr-merged directories by comparing inode to kernel_path
        if [[ -n "${RES[kernel_path]}" && -e "$lookup_dir/$cmd" ]]; then
            local inode1 inode2
            inode1=$(stat -c %i "$lookup_dir/$cmd" 2>/dev/null || echo "")
            inode2=$(stat -c %i "${RES[kernel_path]}" 2>/dev/null || echo "")
            [[ "$inode1" == "$inode2" && "$lookup_dir/$cmd" != "${RES[kernel_path]}" ]] && usr_merged=" [usr-merged]"
        fi

        case "$state" in
            notfound)
                printf "  ↳ %-24s - not found\n" "$display_dir"
                ;;
            file)
                if [[ $shadow == true ]]; then
                    printf "  ↳ %-24s - ${__CT_GREY}%s [shadowed]%s${__CT_RESET}\n" "$display_dir" "$cmd" "$usr_merged"
                else
                    printf "  ↳ %-24s - ${__CT_CYAN}%s found${__CT_RESET}%s\n" "$display_dir" "$cmd" "$usr_merged"
                fi
                ;;
            symlink)
                if [[ $shadow == true ]]; then
                    printf "  ↳ %-24s - ${__CT_GREY}%s (symlink) [shadowed]%s${__CT_RESET}\n" "$display_dir" "$cmd" "$usr_merged"
                else
                    printf "  ↳ %-24s - ${__CT_CYAN}%s${__CT_RESET} → ${__CT_YELLOW}%s${__CT_RESET}%s\n" \
                    "$display_dir" "$cmd" "$target" "$usr_merged"
                fi
                ;;
        esac    
    done
    
    if [[ ${RES[empty_path_component]} == true ]]; then
        printf "\n"
        printf "PATH Note: An empty PATH component exists in \$PATH.\n"
        printf "  ↳ Bash treats an empty PATH component as the current directory (.).\n"
    fi

    printf "\n"

    # ------------------------------------------------------------
    # Bash resolution target
    # ------------------------------------------------------------
    printf "Bash Resolution Target:\n"

    case "${RES[bash_type]}" in
        keyword) winner_display="${__CT_CYAN}Keyword → ${RES[command]}${__CT_RESET}" ;;
        alias)    winner_display="${__CT_CYAN}Alias → ${RES[command]} → ${RES[alias_def]}${__CT_RESET}" ;;
        function) winner_display="${__CT_CYAN}Function → ${RES[command]} → ${RES[function_file]} : line ${RES[function_line]}${__CT_RESET}" ;;
        builtin)  winner_display="${__CT_CYAN}Builtin → ${RES[command]} → ${RES[builtin_state]}${__CT_RESET}" ;;
        path)     winner_display="${__CT_CYAN}Filesystem → ${RES[kernel_path]}${__CT_RESET}" ;;
        *)        printf "not found\n" ;;
    esac
    printf "  ↳ Resolved to: %s\n" "$winner_display"

    # Check for secondary entity if keyword won and a shadowed alias or builtin exists
    if [[ "${RES[bash_type]}" == "keyword" ]]; then
        if [[ ${RES[alias_found]} == true ]]; then
            printf "          ↳ And: ${__CT_CYAN}Alias → %s${__CT_RESET}\n" "${RES[alias_def]}"  
        fi
    
        if [[ ${RES[builtin_state]} == "enabled" ]]; then
            printf "          ↳ And: ${__CT_CYAN}Builtin → %s → %s${__CT_RESET}\n"  "${RES[command]}" "${RES[builtin_state]}"
        elif [[ ${RES[builtin_state]} == "disabled" ]]; then
            printf "          ↳ And: ${__CT_GREY}Builtin → %s → %s${__CT_RESET}\n"  "${RES[command]}" "${RES[builtin_state]}"
            printf "  ↳ Note: Builtin implementation is disabled; execution will fail.\n"

        fi    

        if [[ ${RES[alias_found]} == true || 
            ${RES[function_found]} == true ||
            ${RES[shadowed_fs]} == true ]]; then
            printf "  ↳ Note: Keyword ${__CT_CYAN}'%s'${__CT_RESET} always wins in its reserved context; other commands are ignored.\n" \
            "${RES[command]}"
        fi
    fi
    
    if [[ ${RES[function_found]} == true && ${RES[function_shadowed]} == true ]]; then
        printf "  ↳ Note: Function ${__CT_CYAN}'%s'${__CT_RESET} is unreachable by bare invocation.\n" "$cmd"
    fi
    
    if [[ ${RES[builtin_found]} == true && ${RES[builtin_shadowed]} == true ]]; then
        printf "  ↳ Note: Builtin ${__CT_CYAN}'%s'${__CT_RESET} is unreachable by bare invocation.\n" "$cmd"
    fi
    
    # Only print shadowed note for non-builtin
    if [[ ${RES[shadowed_fs]} == true ]]; then
        printf "  ↳ Note: Filesystem executables named ${__CT_CYAN}'%s'${__CT_RESET} are unreachable by bare invocation.\n" "$cmd"
    fi

    printf "\n"

    # ------------------------------------------------------------
    # Kernel execution target
    #
    # Only applies when bash_type == path.
    # ------------------------------------------------------------
    printf "Kernel Execution Target:\n"

    if [[ ${RES[bash_type]} == path ]]; then
        if [[ "${RES[kernel_path]}" != "${RES[kernel_canonical]}" ]]; then
            printf "  ↳ Executable → ${__CT_BPURP}%s${__CT_RESET}\n" "${RES[kernel_canonical]}"
        else
            printf "  ↳ Executable → ${__CT_CYAN}%s${__CT_RESET}\n" "${RES[kernel_canonical]}"
        fi

        [[ -n ${RES[elf_interp]} ]] && \
        printf "  ↳ ELF interpreter: ${__CT_CYAN}%s${__CT_RESET}\n" "${RES[elf_interp]}"

        [[ -n ${RES[shebang]} ]] && \
        printf "  ↳ Shebang: ${__CT_CYAN}%s${__CT_RESET}\n" "${RES[shebang]}"

        # symlink chain
        if [[ -n ${RES[kernel_chain]} ]]; then
            printf "  ↳ Symlink chain:\n"
            IFS=$'\n' read -r -d '' -a chain_lines <<<"${RES[kernel_chain]}" || true

            local last_index=$(( ${#chain_lines[@]} - 1 ))
            for i in "${!chain_lines[@]}"; do
                local line="${chain_lines[i]}"
                local src="${line%% -> *}"
                local tgt="${line##* -> }"
    
                if (( i == last_index )); then
                    # Final target (kernel executable)
                    printf "       → ${__CT_YELLOW}%s${__CT_RESET} -> ${__CT_BPURP}%s${__CT_RESET}\n" "$src" "$tgt"
                else
                    # intermediate symlink
                    printf "       → ${__CT_CYAN}%s${__CT_RESET} -> ${__CT_YELLOW}%s${__CT_RESET}\n" "$src" "$tgt"
                fi
            done
        fi  
    else
        printf "  ↳ NONE\n"
    fi

    printf "\n"
}

#------------------------------------------------------------------------
# Function: _ct_startup
# Purpose : One-time setup per ct invocation
#
# Ensures environment consistency and dependency availability.
#------------------------------------------------------------------------
_ct_startup() {
    local __CT_EXTEND_PATH="$1"
    # Save PATH if not already saved.
    if (( ! __CT_PATH_SAVED )); then
        __CT_OLD_PATH="$PATH"
        __CT_PATH_SAVED=1
    fi
    _ct_setup_colors
    _ct_bash_posix_mode
    
    _ct_bash_ver_check || return 1  # 1 = exit if required
    _ct_check_dependencies __CT_needed_deps __CT_optional_deps 1  || return 1 
    
    (( __CT_EXTEND_PATH )) && _ct_add_admin_paths
    _ct_enable_extglob
}

#------------------------------------------------------------------------
# Function: _ct_bash_posix_mode
# Purpose : Check if bash posix mode to apply posix rules if needed
#------------------------------------------------------------------------
_ct_bash_posix_mode() {
    __CT_POSIX_MODE=0
    
    shopt -qo posix && __CT_POSIX_MODE=1
    
}

#------------------------------------------------------------------------
# Function: _ct_exit
# Purpose : Cleanup handler
#
# Registered via trap to guarantee restoration of shell state.
#------------------------------------------------------------------------
_ct_exit() {

    _ct_restore_path
    _ct_reset_extglob
    __CT_EXTEND_PATH=0
    __CT_AUTO_EXTEND=0
    __CT_POSIX_MODE=0
}
#------------------------------------------------------------------------
# Function: _ct_usage
# Purpose : Display usage information and examples for the `h` command analyzer.
#------------------------------------------------------------------------
_ct_usage() {
    cat <<'EOF'

    Usage:
      ct [options] command

    Command Trace (ct) analyzes how Bash resolves a command name
    and traces the filesystem and execution layers that follow.

    The command must be provided as a bare command name.
    Paths such as /bin/ls or ./script are rejected.

    Options:
      -h, --help        Show this help text
      -v, --version     Show version and license information
      -j, --json        Emit JSON output suitable for scripting
      -c, --conflict    Show all conflicting commands in the namespace
      -x, --extend      Force $PATH extension to find shadowed admin files
     
EOF
}

#------------------------------------------------------------------------
# Function: _ct_ver
# Purpose : Display version information.
#------------------------------------------------------------------------
_ct_ver() {

    printf "\n     ct v%s  — Command Trace\n" "$__CT_version"
    cat <<'EOF'
    
     MIT License
     
     Copyright (c) 2025-2026 John Blair

     Permission is hereby granted, free of charge, to any person obtaining a copy
     of this software and associated documentation files (the "Software"), to deal
     in the Software without restriction, including without limitation the rights
     to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
     copies of the Software, and to permit persons to whom the Software is
     furnished to do so, subject to the following conditions:

     The above copyright notice and this permission notice shall be included in all
     copies or substantial portions of the Software.

     THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
     IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
     FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
     AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
     LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
     OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
     SOFTWARE.

EOF
}

#------------------------------------------------------------------------
# Function: _ct_setup_colors         Colors (tput → ANSI → none)
# Purpose : make stuff pretty also safe for different setups
#------------------------------------------------------------------------
_ct_setup_colors() {
    if command -v tput &>/dev/null && [[ $(tput colors 2>/dev/null) -ge 8 ]]; then
        __CT_RED=$(tput setaf 1)
        __CT_GREEN=$(tput setaf 2)
        __CT_CYAN=$(tput setaf 6)
        __CT_YELLOW=$(tput setaf 11)
        __CT_BPURP=$(tput setaf 13)
        __CT_GREY=$(tput setaf 245)
        __CT_RESET=$(tput sgr0)
        __CT_UNLINE=$(tput smul)
        __CT_STOPUNLINE=$(tput rmul)
    else
        __CT_RED='\033[31m'
        __CT_GREEN='\033[32m'
        __CT_CYAN='\033[36m'
        __CT_YELLOW='\033[93m'
        __CT_BPURP='\033[95m'
        __CT_GREY='\033[90m'
        __CT_RESET='\033[0m'
        __CT_UNLINE='\033[4m'
        __CT_STOPUNLINE='\033[24m'   
    fi

    # Ensure variables are always set
    : "${__CT_RED:=}"
    : "${__CT_GREEN:=}"
    : "${__CT_CYAN:=}"
    : "${__CT_YELLOW:=}"
    : "${__CT_BPURP:=}"
    : "${__CT_GREY:=}"
    : "${__CT_RESET:=}"
    : "${__CT_UNLINE:=}"
    : "${__CT_STOPUNLINE:=}"
}

#------------------------------------------------------------------------
# Function: _ct_add_admin_paths
# Purpose : Temporarily extend PATH for discovery
#
# Adds common user, admin, package-manager, and container paths.
#------------------------------------------------------------------------
_ct_add_admin_paths() {
 
    # Save PATH if not already saved.
    if (( ! __CT_PATH_SAVED )); then
        __CT_OLD_PATH="$PATH"
        __CT_PATH_SAVED=1
    fi

    local admin_dirs=(
        "/flatpak/bin"
        "/snap/bin"
        "/usr/local/sbin" 
        "/usr/sbin"
        "/sbin"
        "/opt/sbin"
    )
        
    for dir in "${admin_dirs[@]}"; do
        [[ -d "$dir" && ":$PATH:" != *":$dir:"* ]] && PATH="$PATH:$dir"
    done
}

#------------------------------------------------------------------------
# Function: _ct_restore_path
# Purpose : Automatically restore PATH when needed
#------------------------------------------------------------------------
_ct_restore_path() {
    if (( __CT_PATH_SAVED )); then
         PATH="$__CT_OLD_PATH"
         unset __CT_OLD_PATH
        __CT_PATH_SAVED=0
     fi
}

#------------------------------------------------------------------------
# Function: _ct_completion
# Purpose : Enable tab completion for entering commands 
#------------------------------------------------------------------------
# Completion Notes:
#
# • Completion temporarily extends PATH to match ct resolution behavior.
# • Results include aliases, functions, builtins, and PATH commands.
#------------------------------------------------------------------------
_ct_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local commands
    
    local _old_path="$PATH"
    local _old_path_saved="$__CT_PATH_SAVED"
    local _old_saved_path="${__CT_OLD_PATH-}"
    
    _ct_add_admin_paths
    
    # Collect possible completions: aliases, functions, builtins, and executables in PATH
    mapfile -t commands < <(compgen -A function -A alias -A builtin -A command -- "$cur")
    # Provide them to bash-completion
    COMPREPLY=("${commands[@]}")
    
    PATH="$_old_path"
    __CT_PATH_SAVED="$_old_path_saved"
    if (( _old_path_saved )); then
        __CT_OLD_PATH="$_old_saved_path"
    else
        unset __CT_OLD_PATH
    fi
}

#------------------------------------------------------------------------
# Function: _ct_enable_extglob  
# Purpose : Safely manage extglob state
#
# extglob is needed for advanced pattern matching but must not
# permanently alter the user's shell environment.
#------------------------------------------------------------------------
_ct_enable_extglob() {
    __CT_extglob_was=0

    if shopt -q extglob; then
        __CT_extglob_was=1
    else
        shopt -s extglob
    fi
}
#------------------------------------------------------------------------
# Function: _ct_reset_extglob
# Purpose : Restore extglob to prior state, safley turn off if needed.
#------------------------------------------------------------------------
_ct_reset_extglob() {
    if (( ! __CT_extglob_was )); then
        shopt -u extglob
    fi
    __CT_extglob_was=0
}
#------------------------------------------------------------------------
# Function: _ct_check_dependencies
# Purpose : Check core and optional dependencies, optionally exit on missing core deps
# Usage   : _ct_check_dependencies __CT_needed_deps __CT_optional_deps [EXIT_ON_MISSING] 0or1
#------------------------------------------------------------------------
_ct_check_dependencies() {
    local -n required="$1"
    local -n optional="$2"
    local exit_on_missing="${3:-1}"

    local missing_required=()
    local missing_optional=()

    for cmd in "${required[@]}"; do
        command -v "$cmd" >/dev/null 2>&1 || missing_required+=("$cmd")
    done

    for cmd in "${optional[@]}"; do
        command -v "$cmd" >/dev/null 2>&1 || missing_optional+=("$cmd")
    done

    if (( ${#missing_required[@]} )); then
        printf "%b\n" "${__CT_RED}Warning: Missing REQUIRED tools: ${missing_required[*]}${__CT_RESET}"
        if (( exit_on_missing )); then
            printf "%b\n" "${__CT_RED}Cannot continue analysis without core dependencies.${__CT_RESET}"
            return 1
        fi
    fi
    return 0
}

#------------------------------------------------------------------------
# Function: _ct_bash_ver_check
# Purpose : Enforce minimum Bash version
#
# Bash 4.4+ is required.
#
# ct relies heavily on associative arrays and namerefs for _ct_resolve.
# Associative arrays were introduced in Bash 4.0, and namerefs were
# introduced in Bash 4.3. Bash 4.4 substantially revised and stabilized
# nameref behavior and added further improvements to array handling.
#------------------------------------------------------------------------
_ct_bash_ver_check() {
    local MIN_BASH_MAJOR=4
    local MIN_BASH_MINOR=4
    local CURRENT_BASH_MAJOR=${BASH_VERSINFO[0]}
    local CURRENT_BASH_MINOR=${BASH_VERSINFO[1]}

    if (( CURRENT_BASH_MAJOR < MIN_BASH_MAJOR )) || \
       (( CURRENT_BASH_MAJOR == MIN_BASH_MAJOR && CURRENT_BASH_MINOR < MIN_BASH_MINOR )); then
        printf "Error: Bash %d.%d or higher is required for 'ct'. You are using %d.%d.\n" \
            "$MIN_BASH_MAJOR" "$MIN_BASH_MINOR" "$CURRENT_BASH_MAJOR" "$CURRENT_BASH_MINOR" >&2
        printf "Please upgrade your Bash version to use this script.\n" >&2
        return 1
    fi
}

#------------------------------------------------------------------------
# Function: _ct_json_output
# Purpose : json output the name kind of says it all...
#------------------------------------------------------------------------
# JSON OUTPUT NOTES:
#
# • JSON output is intended for scripting and inspection.
# • Fields may be added in future versions; consumers should not assume
#   strict schema stability across major versions.
#
# • Null values indicate "not applicable" or "not present".
# • Boolean fields are always true/false (never null).
#
# • bash_type possible values:
#     alias | function | keyword | builtin | path | notfound
#------------------------------------------------------------------------
_ct_json_output() {
    local cmd="$1"
    declare -A RES
    declare -a PATH_ENTRIES

    _ct_resolve "$cmd" RES PATH_ENTRIES || return 1

    # Precompute JSON values
    local bash_type_json
    bash_type_json=$(_ct_json_string_or_null "${RES[bash_type]}")

    if (( __CT_POSIX_MODE )); then
        local posix_mode=true
    else
        local posix_mode=false
    fi

    # auto_extended is true only when ct automatically
    # extended PATH after the command was not found.
    local auto_extended_json=false
    (( __CT_AUTO_EXTEND )) && auto_extended_json=true

    local alias_def_json
    local function_file_json
    local function_line_json
    local builtin_state_json
    local kernel_path_json
    local kernel_canonical_json
    local elf_interp_json
    local shebang_json

    alias_def_json=$(_ct_json_string_or_null "${RES[alias_def]}")
    function_file_json=$(_ct_json_string_or_null "${RES[function_file]}")
    function_line_json=$(_ct_json_string_or_null "${RES[function_line]}")
    builtin_state_json=$(_ct_json_string_or_null "${RES[builtin_state]}")
    kernel_path_json=$(_ct_json_string_or_null "${RES[kernel_path]}")
    kernel_canonical_json=$(_ct_json_string_or_null "${RES[kernel_canonical]}")
    elf_interp_json=$(_ct_json_string_or_null "${RES[elf_interp]}")
    shebang_json=$(_ct_json_string_or_null "${RES[shebang]}")

    # PATH JSON, one object per line
    local path_json="["
    local dir state target shadow
    local dir_json state_json target_json
    local shadow_json
    local usr_merged

    for entry in "${PATH_ENTRIES[@]}"; do
        IFS='|' read -r dir state target shadow <<<"$entry"
        
        dir_json=$(_ct_json_string "$dir")
        state_json=$(_ct_json_string_or_null "$state")
        target_json=$(_ct_json_string_or_null "$target")

        [[ $shadow == true ]] && shadow_json=true || shadow_json=false

        usr_merged=false

        case "$dir" in
            /bin|/sbin|/lib|/lib64)
                if [[ -L "$dir" ]]; then
                    # symlinked usr-merge
                    [[ $(readlink -f -- "$dir") == /usr/* ]] && usr_merged=true
                else
                    # inode-identical usr-merge (bind mount or hard layout)
                    local usr_dir="/usr$dir"
                    if [[ -d "$usr_dir" ]]; then
                        [[ $(stat -Lc '%d:%i' -- "$dir" 2>/dev/null) == \
                           $(stat -Lc '%d:%i' -- "$usr_dir" 2>/dev/null) ]] && usr_merged=true
                    fi
                fi
                ;;
        esac

        path_json+=$'\n    {'
        path_json+="\"dir\": $dir_json,"
        path_json+="\"state\": $state_json,"
        path_json+="\"target\": $target_json,"
        path_json+="\"shadowed\": $shadow_json,"
        path_json+="\"usr_merged\": $usr_merged"
        path_json+="},"
    done

    # Remove trailing comma and add closing bracket
    path_json="${path_json%,}"$'\n]'

    # Convert kernel_chain string to JSON array
    local chain_json=""
    if [[ -n "${RES[kernel_chain]}" ]]; then
        local first=1
        local line

        while IFS= read -r line; do
            (( first )) || chain_json+=", "
            chain_json+="$(_ct_json_string_or_null "$line")"
            first=0
        done <<<"${RES[kernel_chain]}"
    fi

    local datetime
    datetime=$(printf '%(%Y-%m-%dT%H:%M:%S%z)T\n' -1)

    local report_time_json
    local command_json

    report_time_json=$(_ct_json_string_or_null "$datetime")
    command_json=$(_ct_json_string_or_null "${RES[command]}")

    # Output JSON
    cat <<EOF
{
  "report_time": $report_time_json,
  "command": $command_json,
  "posix_mode": $posix_mode,
  "auto_extended": $auto_extended_json,
  "bash_type": $bash_type_json,
  "shadowed_fs": ${RES[shadowed_fs]},
  "alias": {
    "found": ${RES[alias_found]},
    "definition": $alias_def_json
  },
  "keyword": {
    "found": ${RES[keyword_found]}
  },
  "function": {
    "found": ${RES[function_found]},
    "file": $function_file_json,
    "line": $function_line_json,
    "shadowed": ${RES[function_shadowed]}
  },
  "builtin": {
    "found": ${RES[builtin_found]},
    "state": $builtin_state_json,
    "shadowed": ${RES[builtin_shadowed]}
  },
  "path": $path_json,
  "kernel": {
    "path": $kernel_path_json,
    "canonical": $kernel_canonical_json,
    "elf_interpreter": $elf_interp_json,
    "shebang": $shebang_json,
    "chain": [$chain_json]
  }
}
EOF
}

#------------------------------------------------------------------------
# Function: _ct_json_string
# Purpose : Emit a JSON string, including an empty string.
#------------------------------------------------------------------------
_ct_json_string() {
    local s=$1
    local out='"'
    local i char

    for (( i=0; i<${#s}; i++ )); do
        char=${s:i:1}

        case "$char" in
            $'\b') out+='\\b' ;;
            $'\f') out+='\\f' ;;
            $'\n') out+='\\n' ;;
            $'\r') out+='\\r' ;;
            $'\t') out+='\\t' ;;
            $'\\')  out+=$'\\\\' ;;
            '"')    out+='\"' ;;
            *)      out+="$char" ;;
        esac
    done

    out+='"'
    printf '%s' "$out"
}

#------------------------------------------------------------------------
# Function: _ct_json_string_or_null
# Purpose : Emit a JSON string or JSON null.
#------------------------------------------------------------------------
_ct_json_string_or_null() {
    if [[ -z $1 || $1 == "null" ]]; then
        printf 'null'
        return
    fi

    local s=$1
    local out='"'
    local i char

    for (( i=0; i<${#s}; i++ )); do
        char=${s:i:1}

        case "$char" in
            $'\b') out+='\\b' ;;
            $'\f') out+='\\f' ;;
            $'\n') out+='\\n' ;;
            $'\r') out+='\\r' ;;
            $'\t') out+='\\t' ;;
            $'\\')   out+=$'\\\\' ;;
            '"') out+='\"' ;;
            *)     out+="$char" ;;
        esac
    done

    out+='"'
    printf '%s' "$out"
}

#------------------------------------------------------------------------
# Function: _ct_conflicts       Command Resolution & Shadowing Report    
# Purpose : dispatch to json or print output
#------------------------------------------------------------------------
_ct_conflicts() {
    local __CT_JSON_OUTPUT="$1"
    local __CT_EXTEND_PATH="$2"
    
    _ct_startup "$__CT_EXTEND_PATH" || return 1
    
    if [[ $__CT_JSON_OUTPUT == 1 ]]; then
         _ct_conflicts_json
         return 0
    fi     

    _ct_conflicts_print
}

#------------------------------------------------------------------------
# Function: _ct_conflicts_print       Command Resolution & Shadowing Report    
# Purpose : list all commands that conflict with other command names
#------------------------------------------------------------------------
_ct_conflicts_print() {

    _ct_setup_colors
   
    # Create temporary directory
    local tmpdir
    tmpdir=$(mktemp -d) || { printf "Failed to create temp dir\n" >&2; return 1; }

    {  # run all jobs at once.  
     
        local monitor_was_enabled=0
        shopt -qo monitor && monitor_was_enabled=1
        set +m
        
        (_ct_keyword_conflicts  > "$tmpdir/keywords") &
        (_ct_alias_conflicts    > "$tmpdir/aliases") &
        (_ct_function_conflicts > "$tmpdir/functions") &
        (_ct_builtin_conflicts  > "$tmpdir/builtins") &
        wait
    } 2>/dev/null # suppress output
   
    # Restore original job-control state
    if (( monitor_was_enabled )); then
        set -m
    else
        set +m
    fi          
   
    # print output in proper order
    printf "\n"
    cat "$tmpdir/keywords"
    cat "$tmpdir/aliases"
    cat "$tmpdir/functions"
    cat "$tmpdir/builtins"
    
    # All workers have finished; clean up now.
    rm -rf "$tmpdir"
}

#------------------------------------------------------------------------
# Function: _ct_keyword_conflicts
# Purpose : list all shell keywords that conflict with other command names
#------------------------------------------------------------------------
_ct_keyword_conflicts() {
    local kw kinds winner
    
    printf "Command Resolution & Shadowing Report:\n"
    printf "This may take a moment\n\n"
    
    if [[ $__CT_EXTEND_PATH == 1 ]]; then
             printf "\$PATH has been manually extended.\n\n"
    fi     
    
    printf "Keywords \n"

    for kw in "${__CT_KEYWORDS[@]}"; do
        declare -A RES
        declare -a PATH_ENTRIES

        _ct_resolve "$kw" RES PATH_ENTRIES

        kinds=()

        [[ ${RES[alias_found]} == true ]]    && kinds+=("alias")
        [[ ${RES[function_found]} == true ]] && kinds+=("function")
        [[ ${RES[builtin_found]} == true ]]  && kinds+=("builtin")
      
        # Detect external presence
        local has_external=false
        for entry in "${PATH_ENTRIES[@]}"; do
            IFS='|' read -r _ state _ _ <<<"$entry"
            if [[ "$state" != "notfound" ]]; then
                has_external=true
                break
            fi
        done
        [[ $has_external == true ]] && kinds+=("external")
        
        # determine winner using resolver
        winner="${RES[bash_type]}"
        [[ "$winner" == "path" ]] && winner="external"
        
        if ((${#kinds[@]} > 0)); then
            printf "  Keyword: ${__CT_CYAN}%-11s${__CT_RESET}\n" "$kw"
            
            if [[ "$winner" == "keyword" ]]; then
                printf "     ↳ Also defined as: %s\n\n" \
                    "$(_ct_format_kinds "" "${kinds[@]}")"
            else
                printf "     ↳ Also defined as: %s\n\n" \
                    "$(_ct_format_kinds "$winner" "${kinds[@]}")"
            fi
        fi
    done 
    printf "\n"
}

#------------------------------------------------------------------------
# Function: _ct_alias_conflicts
# Purpose : list all aliases that conflict with other command names
#------------------------------------------------------------------------
_ct_alias_conflicts() {
    local acmd kinds winner
    printf "Aliases \n"

    while IFS= read -r acmd; do
        declare -A RES
        declare -a PATH_ENTRIES

        _ct_resolve "$acmd" RES PATH_ENTRIES

        kinds=()

        # collect other kinds (exclude alias itself)
        [[ ${RES[function_found]} == true ]] && kinds+=("function")
        [[ ${RES[builtin_found]} == true ]]  && kinds+=("builtin")
        [[ ${RES[keyword_found]} == true ]]  && kinds+=("keyword")

        # detect external presence (not just winner)
        local has_external=false
        for entry in "${PATH_ENTRIES[@]}"; do
            IFS='|' read -r _ state _ _ <<<"$entry"
            if [[ "$state" != "notfound" ]]; then
                has_external=true
                break
            fi
        done
        [[ $has_external == true ]] && kinds+=("external")
 
        # determine winner using resolver
        winner="${RES[bash_type]}"
        [[ "$winner" == "path" ]] && winner="external"

        local display_winner="$winner"
        if [[ "$winner" != "alias" ]]; then
            display_winner="${__CT_YELLOW}${winner}${__CT_RESET}"
        fi

        # only show real conflicts
        if ((${#kinds[@]} > 0)); then
            printf "  Alias: ${__CT_CYAN}%-13s${__CT_RESET}\n" "$acmd"
            printf "     ↳ Also defined as: %s\n" \
                "$(_ct_format_kinds "$winner" "${kinds[@]}")"
            printf "     ↳ Resolution:      %s wins\n\n" "$display_winner"
        fi

    done < <(compgen -A alias)
    printf "\n"
}

#------------------------------------------------------------------------
# Function: _ct_function_conflicts
# Purpose : list all shell functions that conflict with other command names
#------------------------------------------------------------------------
_ct_function_conflicts() {
    local fname kinds winner
    printf "Functions \n"

    while IFS= read -r fname; do
        declare -A RES
        declare -a PATH_ENTRIES

        _ct_resolve "$fname" RES PATH_ENTRIES

        kinds=()

        # collect other kinds (exclude function itself)
        [[ ${RES[alias_found]} == true ]]   && kinds+=("alias")
        [[ ${RES[keyword_found]} == true ]] && kinds+=("keyword")
        [[ ${RES[builtin_found]} == true ]]  && kinds+=("builtin")
        
        # detect external presence (not just winner)
        local has_external=false
        for entry in "${PATH_ENTRIES[@]}"; do
            IFS='|' read -r _ state _ _ <<<"$entry"
            if [[ "$state" != "notfound" ]]; then
                has_external=true
                break
            fi
        done
        [[ $has_external == true ]] && kinds+=("external")
 
        # determine winner using resolver
        winner="${RES[bash_type]}"
        [[ "$winner" == "path" ]] && winner="external"

        local display_winner="$winner"
        if [[ "$winner" != "function" ]]; then
            display_winner="${__CT_YELLOW}${winner}${__CT_RESET}"
        fi

        # only show real conflicts
        if ((${#kinds[@]} > 0)); then
            printf "  Function: ${__CT_CYAN}%-10s${__CT_RESET}\n" "$fname"
            printf "     ↳ Also defined as: %s\n" \
                 "$(_ct_format_kinds "$winner" "${kinds[@]}")"
            printf "     ↳ Resolution:      %s wins\n\n" "$display_winner"
        fi

    done < <(compgen -A function)
    
    printf "\n"
}

#------------------------------------------------------------------------
# Function: _ct_builtin_conflicts
# Purpose : list all builtins that conflict with other command names
#------------------------------------------------------------------------
_ct_builtin_conflicts() {
    local bcmd kinds winner
    
    printf "Builtins \n"

    for bcmd in "${__CT_BUILTINS[@]}"; do
        declare -A RES
        declare -a PATH_ENTRIES

        _ct_resolve "$bcmd" RES PATH_ENTRIES

        kinds=()

        [[ ${RES[alias_found]} == true ]]    && kinds+=("alias")
        [[ ${RES[function_found]} == true ]] && kinds+=("function")
        [[ ${RES[keyword_found]} == true ]]  && kinds+=("keyword")
        
        local enabled_state="${RES[builtin_state]}"
        [[ "$enabled_state" == "disabled" ]] && enabled_state="(disabled)"
        
        local has_external=false
        for entry in "${PATH_ENTRIES[@]}"; do
            IFS='|' read -r _ state _ _ <<<"$entry"
            if [[ "$state" != "notfound" ]]; then
                has_external=true
                break
            fi
        done
        [[ $has_external == true ]] && kinds+=("external")

        winner="${RES[bash_type]}"
        [[ "$winner" == "path" ]] && winner="external"

        local display_winner="$winner"
        if [[ "$winner" != "builtin" ]]; then
            display_winner="${__CT_YELLOW}${winner}${__CT_RESET}"
        fi

        if ((${#kinds[@]} > 0)); then
            printf "  Builtin: ${__CT_CYAN}%-12s${__CT_RESET} %s\n" "$bcmd" "$enabled_state"
            printf "     ↳ Also defined as: %s\n" \
                "$(_ct_format_kinds "$winner" "${kinds[@]}")"
            printf "     ↳ Resolution:      %s wins\n\n" "$display_winner"
        fi
    done

    printf "\n"
}
#------------------------------------------------------------------------
# Function: _ct_format_kinds
# Purpose : format output for consistency
#------------------------------------------------------------------------
_ct_format_kinds() {
    local winner="$1"
    shift

    local seen=()
    local ordered=()
    local k base note

    for k in "$@"; do
        base="${k%%(*}"
        note=""

        if [[ "$base" != "$winner" ]]; then
            note="(shadowed)"
        fi

        k="$base$note"
        [[ ! " ${seen[*]} " =~ $k ]] && seen+=("$k")
    done

    local order=(alias function builtin keyword external)
    for o in "${order[@]}"; do
        for s in "${seen[@]}"; do
            [[ "$s" == "$o"* ]] && ordered+=("$s")
        done
    done

    (IFS=", "; echo "${ordered[*]}")
}

#------------------------------------------------------------------------
# Function: _ct_conflicts_json
# Purpose : display resolution_&_shadowing_report as JSON
#------------------------------------------------------------------------
_ct_conflicts_json() {
    local kw acmd fname bcmd
    
    # Create temporary directory
    local tmpdir
    tmpdir=$(mktemp -d) || { printf "Failed to create temp dir\n" >&2; return 1; }
    
    {  # run all jobs at once.
    
        local monitor_was_enabled=0
        shopt -qo monitor && monitor_was_enabled=1
        set +m   
    
        (_ct_conflicts_json_keywords  > "$tmpdir/keywords") &
        (_ct_conflicts_json_aliases   > "$tmpdir/aliases") &
        (_ct_conflicts_json_functions > "$tmpdir/functions") &
        (_ct_conflicts_json_builtins > "$tmpdir/builtins") &
        wait
    } 2>/dev/null
    
    # Restore original job-control state
    if (( monitor_was_enabled )); then
        set -m
    else
        set +m
    fi   
    
    # Output results in order
    printf "\n"
    cat "$tmpdir/keywords"
    cat "$tmpdir/aliases"
    cat "$tmpdir/functions"
    cat "$tmpdir/builtins"
    
    rm -rf "$tmpdir"
}
 
#------------------------------------------------------------------------
# Function: _ct_conflicts_json_keywords 
# Purpose :  JSON keyword output
#------------------------------------------------------------------------
_ct_conflicts_json_keywords() {
    printf '{\n'
    printf '  "report_time": "%s",\n' "$(printf '%(%Y-%m-%dT%H:%M:%S%z)T\n' -1)"

    if [[ $__CT_EXTEND_PATH == 1 ]]; then
        # shellcheck disable=SC2016
        printf '  "message": "$PATH has been manually extended.",\n'
    fi    
    
    printf '  "resolution_and_shadowing_report": {\n'
    printf '    "keywords": [\n'
    local first=1
    for kw in "${__CT_KEYWORDS[@]}"; do
        declare -A RES
        declare -a PATH_ENTRIES
        _ct_resolve "$kw" RES PATH_ENTRIES

        local kinds=()

        [[ ${RES[alias_found]} == true ]]    && kinds+=("alias")
        [[ ${RES[function_found]} == true ]] && kinds+=("function")
        [[ ${RES[builtin_found]} == true ]]  && kinds+=("builtin")

        local has_external=false
        for entry in "${PATH_ENTRIES[@]}"; do
            IFS='|' read -r _ state _ _ <<<"$entry"
            [[ "$state" != "notfound" ]] && { has_external=true; break; }
        done
        [[ $has_external == true ]] && kinds+=("external")

        ((${#kinds[@]} == 0)) && continue

        ((first)) || printf ',\n'
        first=0

        printf '      {\n'
        printf '        "name": %s,\n' "$(_ct_json_string_or_null "$kw")"
        printf '        "winner": %s,\n' "$(_ct_json_string_or_null "${RES[bash_type]}")"
        printf '        "also_defined_as": ['
        local i
        for ((i=0;i<${#kinds[@]};i++)); do
            printf '"%s"%s' "${kinds[i]}" "$([[ $i -lt $((${#kinds[@]}-1)) ]] && echo ',')"
        done
        printf ']\n'
        printf '      }'
    done
    printf '\n    ],\n'
}

#------------------------------------------------------------------------
# Function: _ct_conflicts_json_aliases  
# Purpose :  JSON alias output
#------------------------------------------------------------------------
_ct_conflicts_json_aliases() {
    printf '    "aliases": [\n'
    first=1
    while IFS= read -r acmd; do
        declare -A RES
        declare -a PATH_ENTRIES
        _ct_resolve "$acmd" RES PATH_ENTRIES

        local kinds=()
        [[ ${RES[function_found]} == true ]] && kinds+=("function")
        [[ ${RES[builtin_found]} == true ]]  && kinds+=("builtin")
        [[ ${RES[keyword_found]} == true ]]  && kinds+=("keyword")

        local has_external=false
        for entry in "${PATH_ENTRIES[@]}"; do
            IFS='|' read -r _ state _ _ <<<"$entry"
            [[ "$state" != "notfound" ]] && { has_external=true; break; }
        done
        [[ $has_external == true ]] && kinds+=("external")

        ((${#kinds[@]} == 0)) && continue

        ((first)) || printf ',\n'
        first=0
        
        local winner="${RES[bash_type]}"
        [[ "$winner" == "path" ]] && winner="external"

        printf '      {\n'
        printf '        "name": %s,\n' "$(_ct_json_string_or_null "$acmd")"
        printf '        "winner": %s,\n' "$(_ct_json_string_or_null "$winner")"
        printf '        "also_defined_as": ['

        local first_kind=1
        local k
        for k in "${kinds[@]}"; do
            ((first_kind)) || printf ',\n                            '
            first_kind=0

            local shadowed=true
            [[ "$k" == "$winner" ]] && shadowed=false

            printf '{ "type": %s, "shadowed": %s }' \
                   "$(_ct_json_string_or_null "$k")" "$shadowed"
        done

        printf ']\n'
        printf '      }'
 
done < <(compgen -A alias)
    
    printf '\n    ],\n'
}

#------------------------------------------------------------------------
# Function: _ct_conflicts_json_functions  
# Purpose :  JSON function output
#------------------------------------------------------------------------
_ct_conflicts_json_functions() {
    printf '    "functions": [\n'
    first=1
    while IFS= read -r fname; do
        declare -A RES
        declare -a PATH_ENTRIES
        _ct_resolve "$fname" RES PATH_ENTRIES

        local kinds=()
        [[ ${RES[alias_found]} == true ]]   && kinds+=("alias")
        [[ ${RES[keyword_found]} == true ]] && kinds+=("keyword")
        [[ ${RES[builtin_found]} == true ]] && kinds+=("builtin")

        local has_external=false
        for entry in "${PATH_ENTRIES[@]}"; do
            IFS='|' read -r _ state _ _ <<<"$entry"
            [[ "$state" != "notfound" ]] && { has_external=true; break; }
        done
        [[ $has_external == true ]] && kinds+=("external")

        ((${#kinds[@]} == 0)) && continue

        ((first)) || printf ',\n'
        first=0

        local winner="${RES[bash_type]}"
        [[ "$winner" == "path" ]] && winner="external"

        printf '      {\n'
        printf '        "name": %s,\n' "$(_ct_json_string_or_null "$fname")"
        printf '        "winner": %s,\n' "$(_ct_json_string_or_null "$winner")"
        printf '        "also_defined_as": ['

        local first_kind=1
        local k
        for k in "${kinds[@]}"; do
            ((first_kind)) || printf ',\n                            '
            first_kind=0

            local shadowed=true
            [[ "$k" == "$winner" ]] && shadowed=false

            printf '{ "type": %s, "shadowed": %s }' \
                   "$(_ct_json_string_or_null "$k")" "$shadowed"
        done

        printf ']\n'
        printf '      }'
    done < <(compgen -A function)
    printf '\n    ],\n'
}

#------------------------------------------------------------------------
# Function: _ct_conflicts_json_builtins
# Purpose :  JSON builtin output
#------------------------------------------------------------------------
_ct_conflicts_json_builtins() {
    printf '    "builtins": [\n'
    first=1
    for bcmd in "${__CT_BUILTINS[@]}"; do
        declare -A RES
        declare -a PATH_ENTRIES
        _ct_resolve "$bcmd" RES PATH_ENTRIES

        local kinds=()
        [[ ${RES[alias_found]} == true ]]    && kinds+=("alias")
        [[ ${RES[function_found]} == true ]] && kinds+=("function")
        [[ ${RES[keyword_found]} == true ]]  && kinds+=("keyword")

        local has_external=false
        for entry in "${PATH_ENTRIES[@]}"; do
            IFS='|' read -r _ state _ _ <<<"$entry"
            [[ "$state" != "notfound" ]] && { has_external=true; break; }
        done
        [[ $has_external == true ]] && kinds+=("external")

        ((${#kinds[@]} == 0)) && continue

        ((first)) || printf ',\n'
        first=0
        
        # Normalize winner: treat "path" as "external"
        local winner="${RES[bash_type]}"
        [[ "$winner" == "path" ]] && winner="external"
    
        printf '      {\n'
        printf '        "name": %s,\n' "$(_ct_json_string_or_null "$bcmd")"
        printf '        "state": %s,\n' "$(_ct_json_string_or_null "${RES[builtin_state]}")"
        printf '        "winner": %s,\n' "$(_ct_json_string_or_null "$winner")"
        printf '        "also_defined_as": ['

        local first_kind=1
        local k
        for k in "${kinds[@]}"; do
            ((first_kind)) || printf ',\n                            '
            first_kind=0

            local shadowed=true
            [[ "$k" == "$winner" ]] && shadowed=false

            printf '{ "type": %s, "shadowed": %s }' \
                   "$(_ct_json_string_or_null "$k")" "$shadowed"
        done

        printf ']\n'
        printf '      }'
    done
    printf '\n    ]\n'
    printf '  }\n'
    printf '}\n'
}

#------------------------------------------------------------------------
# End of script
